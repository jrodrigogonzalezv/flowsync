rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() && userProfile().role == 'admin';
    }
    function sameOrg(orgId) {
      return isAuth() && userProfile().orgId == orgId;
    }
    function isSuperAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.token.email));
    }

    match /organizations/{orgId} {
      allow read: if (isAuth() && sameOrg(orgId)) || isSuperAdmin();
      allow create: if isAuth();
      allow update: if (isAdmin() && sameOrg(orgId)) || isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || sameOrg(resource.data.orgId) || isSuperAdmin());
      allow create, update: if isAuth() && request.auth.uid == userId;
    }

    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    match /workflows/{workflowId} {
      // unauthenticated clients need to read the workflow to complete flows
      allow read: if !isAuth() || (
        resource.data.userId == request.auth.uid ||
        sameOrg(resource.data.orgId) ||
        isSuperAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() && (
        resource.data.userId == request.auth.uid || sameOrg(resource.data.orgId)
      );
      allow delete: if isAdmin() && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notifId} {
      allow read, update: if isAuth() && sameOrg(resource.data.orgId);
      allow create, delete: if false;
    }

    match /clients/{clientId} {
      // unauthenticated clients write their own profile from public flow page
      allow read: if (isAuth() && sameOrg(resource.data.orgId)) || isSuperAdmin();
      allow create, update: if true;
      allow delete: if isAdmin() && sameOrg(resource.data.orgId);
    }

    match /executions/{executionId} {
      // execution ID is the access token — clients read and update without auth
      allow read: if true;
      allow create: if isAuth();
      allow update: if true;
      allow delete: if isAdmin() && resource.data.userId == request.auth.uid;

      match /messages/{msgId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }
    match /superAdmins/{email} {
      allow read: if isAuth() && request.auth.token.email == email;
      allow write: if false;
    }
  }
}
