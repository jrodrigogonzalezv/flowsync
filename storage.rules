rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /kb/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /profiles/clients/{orgId}/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /client-docs/{orgId}/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /orgs/{orgId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
